<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".SaikouApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Saikou V2"
        android:supportsRtl="true"
        android:theme="@style/Theme.Saikou">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Saikou">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives AniList OAuth callback, extracts token, relaunches app -->
        <activity
            android:name=".LoginCallbackActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|layoutDirection">
            <intent-filter android:label="Anilist Login for Saikou">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="anilist"
                    android:scheme="saikou" />
            </intent-filter>
        </activity>

    </application>

</manifest>
