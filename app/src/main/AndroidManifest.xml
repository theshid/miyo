<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".MiyoApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Miyo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Saikou">

        <!-- Sentry: auto-init reads DSN + config from these meta-data tags. -->
        <meta-data android:name="io.sentry.dsn" android:value="https://771a921dd61df543557574d22677df43@o4511279790686208.ingest.de.sentry.io/4511279799664720" />
        <meta-data android:name="io.sentry.session-replay.on-error-sample-rate" android:value="0" />
        <meta-data android:name="io.sentry.traces.sample-rate" android:value="0" />
        <meta-data android:name="io.sentry.send-default-pii" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|layoutDirection"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Saikou.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives AniList OAuth callback, extracts token, relaunches app -->
        <activity
            android:name=".LoginCallbackActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|layoutDirection">
            <intent-filter android:label="Anilist Login for Miyo">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="anilist"
                    android:scheme="miyo" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.local.downloads.DownloadService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Fires the episode-available notification when an AlarmManager alarm goes off -->
        <receiver
            android:name=".notifications.EpisodeAiringReceiver"
            android:exported="false" />

        <!-- Re-enqueues the episode check worker after device reboot so alarms get re-set.
             Default-disabled: toggled on via PackageManager only when the user actually has
             airing alarms scheduled. Keeps Android from launching the app on every boot
             for users who don't use notifications. -->
        <receiver
            android:name=".notifications.BootCompletedReceiver"
            android:enabled="false"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
