root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
max_line_length = 140

# @Composable functions are PascalCase by Compose convention. Same for
# @Preview helpers and the Compose-Navigation route builders.
ktlint_function_naming_ignore_when_annotated_with = Composable, Preview

# `INSTANCE` is the canonical Room double-checked-locking name; suppress
# at the file level there. Ditto migration constants in SaikouDatabase.

[gradle/libs.versions.toml]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
